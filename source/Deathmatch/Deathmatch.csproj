<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageRoot>$(MSBuildProjectDirectory)/bin/package/</PackageRoot>
    <CssRoot>$(PackageRoot)addons/counterstrikesharp/</CssRoot>
    <PublishDir>$(CssRoot)plugins/Deathmatch/</PublishDir>
    <PackageZip>$(MSBuildProjectDirectory)/bin/Deathmatch.zip</PackageZip>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseCounterStrikeSharp>true</UseCounterStrikeSharp>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MysqlConnector" Version="2.5.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <ProjectReference Include="..\DeathmatchAPI\DeathmatchAPI.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Lang\**\*.*" Link="lang\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Spawns Locations\**\*.*" Link="spawns\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Wipe staging dir so stale files never end up in the zip -->
  <Target Name="CleanPackageRoot" BeforeTargets="PrepareForPublish">
    <RemoveDir Directories="$(PackageRoot)" />
  </Target>

  <Target Name="PublishSharedApi" AfterTargets="Publish">
    <MSBuild Projects="..\DeathmatchAPI\DeathmatchAPI.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(CssRoot)shared/DeathmatchAPI/" />
  </Target>

  <!-- Deathmatch.zip -> addons/counterstrikesharp/{plugins/Deathmatch,shared/DeathmatchAPI} -->
  <Target Name="ZipPackage" AfterTargets="PublishSharedApi">
    <ZipDirectory SourceDirectory="$(PackageRoot)" DestinationFile="$(PackageZip)" Overwrite="true" />
    <Message Importance="high" Text="Deathmatch -> $(PackageZip)" />
  </Target>


  <Import Project="..\..\CounterStrikeSharp.targets" />
</Project>
